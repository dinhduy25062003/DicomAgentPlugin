<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>TDental</vendor>
  <action id="org.tdental.dicom-agent.settings">
    <description>Apply DICOM Agent connection settings</description>
    <message>Authenticate to grant the selected DICOM folder access and apply Agent settings.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/dicom-agent/host/DicomAgent.Host</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--apply-settings</annotate>
  </action>
</policyconfig>
